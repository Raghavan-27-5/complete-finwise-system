# FinWise Core - Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ===========================================
# NEO4J AURA DATABASE (Required)
# Free: https://console.neo4j.io
# ===========================================
AURA_CONNECTION_URI=neo4j+s://your-instance.databases.neo4j.io
AURA_USERNAME=neo4j
AURA_PASSWORD=your-password-here

# ===========================================
# GOOGLE GEMINI API (Optional - deprecated, use OpenRouter instead)
# Free: https://aistudio.google.com/app/apikey
# ===========================================
GEMINI_API_KEY=your-gemini-api-key

# ===========================================
# OPENROUTER API (Recommended - replaces Gemini)
# Free: 50 req/day, 300+ models - https://openrouter.ai/keys
# Recommended models (all free):
#   - deepseek/deepseek-chat (best for financial analysis)
#   - deepseek/deepseek-reasoner (complex reasoning)  
#   - meta-llama/llama-3.3-70b-instruct:free (dialogue)
# ===========================================
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-chat

# ===========================================
# NEWS API (Required for sentiment analysis)
# Free: 100 requests/day - https://newsapi.org
# ===========================================
NEWS_API_KEY=your-newsapi-key

# ===========================================
# FINNHUB API (Recommended - replaces broken scrapers)
# Free: 60 calls/min - https://finnhub.io/register
# ===========================================
FINNHUB_API_KEY=your-finnhub-api-key

# ===========================================
# ALPHA VANTAGE (Optional - for transcripts)
# Free: 25 calls/day - https://www.alphavantage.co/support/#api-key
# ===========================================
ALPHA_VANTAGE_KEY=your-alpha-vantage-key

# ===========================================
# REDDIT API (Optional - for social sentiment)
# Free: https://www.reddit.com/prefs/apps
# ===========================================
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=FinWise/1.0 by u/YourUsername

# ===========================================
# FRED API (Optional - macroeconomic data)
# Free: 100 calls/day - https://fred.stlouisfed.org/docs/api/api_key.html
# ===========================================
FRED_API_KEY=your-fred-api-key

# ===========================================
# NEON POSTGRESQL (Optional - production database)
# Free: 500MB - https://console.neon.tech
# Use this instead of SQLite for production
# ===========================================
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ===========================================
# NO API KEY REQUIRED (Reference)
# ===========================================
# SEC EDGAR: Free, unlimited (10 req/sec) - Just needs User-Agent header
# Yahoo Finance: Free via yfinance library
# Google RSS: Free, no limits

# ===========================================
# PAID / INSTITUTIONAL ONLY (Not included)
# ===========================================
# FINRA ADF/TRF: Institutional subscription required (~$$$)
# CBOE/OCC Options: Paid data feed
# Satellite Imagery: Very expensive (Planet, Orbital Insight)
# Estimize: Was free, now requires enterprise contact

# ===========================================
# DEBUG FLAGS (Optional)
# ===========================================
PIPELINE_DEBUG=0
