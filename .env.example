# FinWise Core - Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ===========================================
# NEO4J AURA DATABASE (Required)
# ===========================================
AURA_CONNECTION_URI=neo4j+s://your-instance.databases.neo4j.io
AURA_USERNAME=neo4j
AURA_PASSWORD=your-password-here

# ===========================================
# GOOGLE GEMINI API (Required)
# ===========================================
GEMINI_API_KEY=your-gemini-api-key

# ===========================================
# NEWS API (Required for sentiment analysis)
# ===========================================
NEWS_API_KEY=your-newsapi-key

# ===========================================
# ALPHA VANTAGE (Optional - for transcripts)
# ===========================================
ALPHA_KEY=your-alpha-vantage-key

# ===========================================
# REDDIT API (Optional - for social sentiment)
# ===========================================
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=FinWise/1.0

# ===========================================
# DEBUG FLAGS (Optional)
# ===========================================
PIPELINE_DEBUG=0
